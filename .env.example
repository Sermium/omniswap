# Copy this file to .env (and/or apps/web/.env.local for the web app) and fill in your own values.
# Never commit real secrets here — this file is tracked in git.

# ============ ENVIRONMENT ============
NODE_ENV=development

# ============ PORTS ============
API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=3002

# ============ DATABASE ============
DB_PORT=5432
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ============ REDIS ============
REDIS_PORT=6379
REDIS_URL=rediss://default:password@host:6379

# ============ AUTH ============
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin panel (apps/web) — see apps/web/src/app/api/admin/auth/login/route.ts
ADMIN_EMAIL=admin@example.com
# scrypt hash of your admin password, as `<saltHex>:<hashHex>` — generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('your-password',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=replace-with-a-real-scrypt-hash
# Random secret used to HMAC-sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Random secret used to HMAC-sign the wallet sign-in session cookie
USER_SESSION_SECRET=change-me-to-a-long-random-string

# ============ SCHEDULED ALERT CHECKS ============
# Shared secret for POST /api/cron/check-alerts. Price alerts will NEVER fire
# until this is set here AND as a GitHub Actions secret of the same name
# (see .github/workflows/check-alerts.yml, which also needs an APP_URL repo
# variable, e.g. https://omniswap-web.vercel.app). The route fails closed
# with 503 if this is missing.
CRON_SECRET=change-me-to-a-long-random-string

# Optional: real alert emails via https://resend.com. Without these an alert
# still triggers in-app and appears in history - only the email is skipped.
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@yourdomain.com

# ============ TELEGRAM MONITORING ============
# Operator notifications (ad booking paid, listing submitted) and the external
# uptime monitor. Create a bot with @BotFather, then message it once and read
# the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
#
# These must be set in BOTH places:
#   - Vercel env vars  -> in-app notifications (payments, listings)
#   - GitHub secrets   -> .github/workflows/monitor.yml + check-alerts.yml
# Both features no-op quietly when unset; nothing else breaks.
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=your-numeric-chat-id

# ============ API KEYS ============
# 1inch (https://portal.1inch.dev)
ONEINCH_API_KEY=your-1inch-api-key
NEXT_PUBLIC_1INCH_API_KEY=your-1inch-api-key

# 0x (https://0x.org/docs/api)
NEXT_PUBLIC_0X_API_KEY=your-0x-api-key

# Li.Fi (https://li.fi)
LIFI_API_KEY=your-lifi-api-key

# MEXC (https://www.mexc.com/api)
MEXC_API_KEY=your-mexc-api-key
MEXC_SECRET_KEY=your-mexc-secret-key

# GoPlus Security (https://gopluslabs.io)
GOPLUS_API_KEY=your-goplus-api-key

# ============ OPTIONAL ============
# Sentry for error tracking
SENTRY_DSN=

# Analytics
MIXPANEL_TOKEN=

# RPC URLs (get free endpoints from Alchemy/Infura/QuickNode)
ETH_RPC_URL=https://ethereum.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SUI_RPC_URL=https://fullnode.mainnet.sui.io

# Other aggregator/bridge API keys
# Socket (Bungee) - Get from https://socket.tech/
SOCKET_API_KEY=your_socket_api_key
# Rango - Get from https://rango.exchange/
RANGO_API_KEY=your_rango_api_key
# Changelly - Get from https://changelly.com/
CHANGELLY_API_KEY=your_changelly_api_key
CHANGELLY_API_SECRET=your_changelly_api_secret
# ChangeNOW - Get from https://changenow.io/
CHANGENOW_API_KEY=your_changenow_api_key

# ============ FRONTEND (apps/web) ============
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Platform fee overrides (fractions, e.g. 0.004 = 0.4%)
NEXT_PUBLIC_PLATFORM_FEE_DIRECT=0.004
NEXT_PUBLIC_PLATFORM_FEE_DELEGATED=0.01
NEXT_PUBLIC_PLATFORM_FEE_CEX=0.01

# Payment wallets that receive ad-booking / listing crypto payments
NEXT_PUBLIC_PAYMENT_WALLET_EVM=0xYourEvmPaymentAddress
NEXT_PUBLIC_PAYMENT_WALLET_SOLANA=YourSolanaPaymentAddress
NEXT_PUBLIC_PAYMENT_WALLET_SUI=0xYourSuiPaymentAddress

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
